#!/usr/bin/env perl

use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/../lib";
use File::Spec;

use D2TG::Config;
use D2TG::Store;

my ( $db_alias, @rest ) = D2TG::Config::extract_db_flag(@ARGV);
@ARGV = @rest;

my $base_dir = eval { D2TG::Config::resolve_alias_dir( alias => $db_alias ) };
if ($@) {
    print STDERR $@;
    exit 1;
}

if ( @ARGV != 1 || $ARGV[0] !~ /^-?\d+$/ ) {
    print STDERR "Usage: d2 tg.approve <chat_id> [--db <alias> | -d <alias>]\n";
    exit 2;
}

my $chat_id = $ARGV[0];

my $store = D2TG::Store->new(
    db_path => D2TG::Config::state_db_path(
        default_root => File::Spec->catdir( $Bin, '..' ),
        base_dir      => $base_dir,
    ),
    admin_chat_id => D2TG::Config::chat_id(),
);

if ( $store->approve($chat_id) ) {
    print "Approved $chat_id\n";
    exit 0;
}

if ( $store->is_allowed($chat_id) ) {
    print STDERR "$chat_id is already allowed - nothing to do\n";
}
else {
    print STDERR "$chat_id was never pending (never sent a message) - nothing to approve\n";
}
exit 1;

=head1 NAME

approve - move a pending chat id into the allow-list, dispatched as C<d2 tg.approve>

=head1 SYNOPSIS

    d2 tg.approve <chat_id> [--db <alias> | -d <alias>]

=head1 DESCRIPTION

C<--db <alias>>/C<-d <alias>> (TGT-051, or C<D2TG_DB=<alias>> as a
fallback) resolves the same way C<d2 tg.poller>'s does - see
L<D2TG::Config/resolve_alias_dir>.

Moves C<chat_id> from L<D2TG::Store>'s C<pending> table into its
C<allow_list>. Prints C<Approved N> and exits 0 on success. If nothing
changed, exits 1 with a message on STDERR distinguishing the two ways
that can happen: the chat id is already allowed (nothing to do), or it
was never pending at all (never messaged the bot, so there's nothing to
approve).

=cut
