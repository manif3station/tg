#!/usr/bin/env perl

use strict;
use warnings;
use FindBin qw($Bin);
use lib "$Bin/../lib";
use File::Spec;

use D2TG::Config;
use D2TG::Telegram;
use D2TG::Poller;
use D2TG::Store;
use D2TG::Download;
use D2TG::Transcribe;

exit 1 unless D2TG::Config::require_chat_id_or_warn();

print "d2tg poller starting up (token set: "
    . ( defined D2TG::Config::token() ? "yes" : "no" ) . ")\n";

my $shutting_down = 0;
$SIG{TERM} = sub { $shutting_down = 1 };
$SIG{INT}  = sub { $shutting_down = 1 };

my $store = D2TG::Store->new(
    db_path => D2TG::Config::state_db_path(
        default_root => File::Spec->catdir( $Bin, '..' )
    ),
    admin_chat_id => D2TG::Config::chat_id(),
);

my $telegram = D2TG::Telegram->new( token => D2TG::Config::token() );
my $offset = $store->get_offset;

my $transcribe_voice = sub {
    my ( $tg, $file_id ) = @_;
    my $local_path = D2TG::Download::download_file( $tg, $file_id );
    my $text = eval { D2TG::Transcribe::transcribe($local_path) };
    my $error = $@;
    unlink $local_path;
    die $error if $error;
    return $text;
};

my $download_media = sub {
    my ( $tg, $file_id ) = @_;
    return D2TG::Download::download_file( $tg, $file_id );
};

until ($shutting_down) {
    ( undef, $offset ) = D2TG::Poller::run_once(
        $telegram, $offset, $store,
        transcribe_voice => $transcribe_voice,
        download_media   => $download_media,
    );
    $store->set_offset($offset) if defined $offset;
}

exit 0;

=head1 NAME

poller - tg skill entrypoint, dispatched as C<d2 tg.poller>

=head1 DESCRIPTION

Calls L<D2TG::Config>'s startup guard first and refuses to proceed
(non-zero exit, nothing on STDOUT) when C<D2TG_CHAT_ID> is missing. Once
the guard passes, opens a L<D2TG::Store> (auto-seeding C<D2TG_CHAT_ID> as
allowed), resumes from its persisted poll offset if any, and runs
L<D2TG::Poller>'s long-poll loop - gated by that store, saving the offset
back after every iteration - until C<SIGTERM> or C<SIGINT> is received.
An allow-listed sender's voice message is downloaded (L<D2TG::Download>)
and transcribed via a local Whisper install (L<D2TG::Transcribe>); the
downloaded temp file is removed either way. A photo or document message
is downloaded via L<D2TG::Download> and its local path printed (kept,
unlike the transient voice download). A download or transcription
failure is reported on STDERR and does not stop the loop.

=cut
